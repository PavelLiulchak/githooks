#!/bin/bash

pushd "$(dirname "$(which "$0")")" >/dev/null
script_dir="$(pwd -P)"
popd >/dev/null

DEV_DIR="code"
QA_DIR="tests"
JIRA_PROJECT_KEY="PROJ"

COMMIT_MSG_FILE=$1

helper_functions_script="$script_dir/hooks-helper-functions.sh"

if [[ ! -f "$helper_functions_script" ]]; then
echo "$helper_functions_script is not found, nothing to source, exiting..."
exit 1
fi

source $helper_functions_script

commit_message_has_real_content() {
  awk '
    /^# ------------------------ >8 ------------------------/ { exit }
    !/^\s*#/ && /\S/ { found=1 }
    END { exit !found }
  ' "$1"
}

# avoid exisitng commit message rewriting, helpful in case of ammends, cherry-picks
if commit_message_has_real_content "$COMMIT_MSG_FILE"; then
  exit 0
fi

if git rev-parse -q --verify MERGE_HEAD >/dev/null; then
  exit 0
fi

mapfile -d '' -t FILES < <(git diff --cached --name-only -z)
COMMON=$(common_path "${FILES[@]}")

# I do this due to the project specific: QA_DIR - is a subdir of DEV_DIR.
# You may use only normalization if they are located on the same level
COMMON_STRIPPED=$(strip_path_before "$COMMON" "$QA_DIR")

COMMON_NORMALIZED=$(get_root_path "$COMMON_STRIPPED")
SCOPE=$(make_scope $COMMON_NORMALIZED $DEV_DIR $QA_DIR)

# Jira ID
BRANCH=$(git branch --show-current)
JIRAID=$(get_jira_id_from_branch_name "$BRANCH" "$JIRA_PROJECT_KEY")

{
    echo "$SCOPE: <write your summary>"
    echo ""
    echo "<write your body>"
    echo ""
    if [ -n "$JIRAID" ]; then
      echo "$JIRAID"
    fi
} > "$COMMIT_MSG_FILE"