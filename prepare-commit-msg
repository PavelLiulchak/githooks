#!/bin/bash

pushd "$(dirname "$(which "$0")")" >/dev/null
script_dir="$(pwd -P)"
popd >/dev/null

commit_msg_file=$1

helper_functions_script="$script_dir/hooks-helper-functions.sh"

if [[ ! -f "$helper_functions_script" ]]; then
echo "$helper_functions_script is not found, nothing to source, exiting..."
exit 1
fi

source "$helper_functions_script"

githooks_config_script="$script_dir/githooks_config.sh"

if [[ ! -f "$githooks_config_script" ]]; then
    echo "Config $githooks_config_script is not found, nothing to source, exiting..."
    exit 1
fi

source "$githooks_config_script"

commit_message_has_real_content() {
  awk '
    /^# ------------------------ >8 ------------------------/ { exit }
    !/^\s*#/ && /\S/ { found=1 }
    END { exit !found }
  ' "$1"
}

# avoid exisitng commit message rewriting, helpful in case of ammends, cherry-picks
if commit_message_has_real_content "$commit_msg_file"; then
  exit 0
fi

if git rev-parse -q --verify MERGE_HEAD >/dev/null; then
  exit 0
fi

mapfile -d '' -t files < <(git diff --cached --name-only -z)

make_general_scope files $path_depth scope team1_rules team2_rules

# Jira ID
branch=$(git branch --show-current)
jira_id=$(get_jira_id_from_branch_name "$branch" "$jira_project_key")

{
    echo "$scope"
    echo ""
    echo ""
    echo ""
    if [ -n "$jira_id" ]; then
      echo "$jira_id"
    fi
} > "$commit_msg_file"