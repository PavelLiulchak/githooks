#!/bin/bash

# Set us!
jira_project_key="PROJ"
# The rules paths are case sensitive
declare -A rules=(
    ['code']="DEV"
    ['code/tests']="QA"
    ['code/autotests']="QA"
)

# Tweak with caution, use numbers only!
after_label_path_depth=1

pushd "$(dirname "$(which "$0")")" >/dev/null
script_dir="$(pwd -P)"
popd >/dev/null

commit_msg_file=$1

helper_functions_script="$script_dir/hooks-helper-functions.sh"

if [[ ! -f "$helper_functions_script" ]]; then
echo "$helper_functions_script is not found, nothing to source, exiting..."
exit 1
fi

source "$helper_functions_script"

commit_message_has_real_content() {
  awk '
    /^# ------------------------ >8 ------------------------/ { exit }
    !/^\s*#/ && /\S/ { found=1 }
    END { exit !found }
  ' "$1"
}

# avoid exisitng commit message rewriting, helpful in case of ammends, cherry-picks
if commit_message_has_real_content "$commit_msg_file"; then
  exit 0
fi

if git rev-parse -q --verify MERGE_HEAD >/dev/null; then
  exit 0
fi

mapfile -d '' -t files < <(git diff --cached --name-only -z)

scope=$(make_scope rules files "$after_label_path_depth")

# Jira ID
branch=$(git branch --show-current)
jira_id=$(get_jira_id_from_branch_name "$branch" "$jira_project_key")

{
    echo "$scope <write your summary>"
    echo ""
    echo "<write your body>"
    echo ""
    if [ -n "$jira_id" ]; then
      echo "$jira_id"
    fi
} > "$commit_msg_file"