#!/bin/bash

# Set us!
jira_project_key="PROJ"
# The rules paths are case sensitive
declare -A rules=(
    ['code']="DEV"
    ['code/tests']="QA"
    ['code/autotests']="QA"
)

# Tweak with caution, use numbers only!
after_label_path_depth=1

pushd "$(dirname "$(which "$0")")" >/dev/null
script_dir="$(pwd -P)"
popd >/dev/null

commit_msg_file=$1

# git config commit.cleanup may be set to print verbose info (additional info lines start with #), we cut them of.
msg=$(cat "$commit_msg_file" | sed '/^#/,$d')

helper_functions_script="$script_dir/hooks-helper-functions.sh"

if [[ ! -f "$helper_functions_script" ]]; then
    echo "$helper_functions_script is not found, nothing to source, exiting..."
    exit 1
fi

source "$helper_functions_script"

commit_message_exists() {
    local file=$1

    grep -qvE '^[[:space:]]*(#|$)' "$file"
}

if commit_message_exists "$commit_msg_file"; then
  exit 0
fi

if git rev-parse -q --verify MERGE_HEAD >/dev/null; then
  exit 0
fi

mapfile -d '' -t files < <(git diff --cached --name-only -z)

scope=$(make_scope rules files "$after_label_path_depth")

# Jira ID
branch=$(git branch --show-current)
jira_id=$(get_jira_id_from_branch_name "$branch" "$jira_project_key")

if [[ -n "$scope" && "$msg" != "$scope"* ]]; then
    msg="$scope $msg"
fi

if [[ -n "$jira_id" && "$msg" != *"$jira_id"* ]]; then
    msg="$msg

$jira_id"
fi

echo "$msg" > "$commit_msg_file"