#!/bin/bash

pushd "$(dirname "$(which "$0")")" >/dev/null
script_dir="$(pwd -P)"
popd >/dev/null

commit_msg_file=$1

# git config commit.cleanup may be set to print verbose info (additional info lines start with #), we cut them of.
msg=$(cat "$commit_msg_file" | sed '/^#/,$d')

helper_functions_script="$script_dir/hooks-helper-functions.sh"

if [[ ! -f "$helper_functions_script" ]]; then
    echo "$helper_functions_script is not found, nothing to source, exiting..."
    exit 1
fi

source "$helper_functions_script"

githooks_config_script="$script_dir/githooks_config.sh"

if [[ ! -f "$githooks_config_script" ]]; then
    echo "Config $githooks_config_script is not found, nothing to source, exiting..."
    exit 1
fi

source "$githooks_config_script"


mapfile -d '' -t index_files < <(git diff --cached --name-only -z)
index_scope=$(make_scope rules index_files "$after_label_path_depth")

# find head scope if head exists, (to detect potential --amend cases)
head_scope=""
if git rev-parse --verify HEAD >/dev/null 2>&1; then
    mapfile -d '' -t head_files < <(git diff-tree --no-commit-id --name-only -r -z HEAD)
    head_scope=$(make_scope rules head_files "$after_label_path_depth")
    echo "head_files == ${head_files[@]}" >> /tmp/hooks_debug/debug.log
    echo "head_scope == $head_scope" >> /tmp/hooks_debug/debug.log
fi

# if you don't modify the message scope intentionally, the msg will contain head_scope in case of amends
if [[ "$msg" == *"$head_scope"* ]]; then
    echo "msg == head_scope" >> /tmp/hooks_debug/debug.log

    files=("${head_files[@]}" "${index_files[@]}")

    echo "files == ${files[@]}" >> /tmp/hooks_debug/debug.log

    # rebuild scope to account for next amend case
    scope=$(make_scope rules files "$after_label_path_depth")

    echo "scope == $scope" >> /tmp/hooks_debug/debug.log

    echo "msg == $msg" >> /tmp/hooks_debug/debug.log
    msg=$(replace_scope "$msg" "$scope")
    echo "msg after repalce == $msg" >> /tmp/hooks_debug/debug.log

else
    if [[ -n "$index_scope" ]]; then
        if [[ $msg == *\(*\):* ]]; then
            msg=$(replace_scope "$msg" "$index_scope")
        else
            msg="$index_scope $msg"
        fi
    fi
fi

# Jira ID
branch=$(git branch --show-current)
jira_id=$(get_jira_id_from_branch_name "$branch" "$jira_project_key")

last_line=$(echo "$msg" | tail -n1)
if [[ -n "$jira_id" && "$last_line" != "$jira_id" ]]; then
    msg="$msg

$jira_id"
fi

echo "" >> /tmp/hooks_debug/debug.log
echo "$msg" > "$commit_msg_file"